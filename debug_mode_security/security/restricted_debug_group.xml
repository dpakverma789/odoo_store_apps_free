<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Category visible in User Access Rights -->
    <record id="module_category_debug_security" model="ir.module.category">
        <field name="name">Debug Security</field>
        <field name="description">Developer Mode Access Control</field>
        <field name="sequence">50</field>
    </record>

    <!-- Privilege (Odoo 19: groups are linked to categories via privileges) -->
    <record id="privilege_debug_security" model="res.groups.privilege">
        <field name="name">Debug Mode</field>
        <field name="category_id" ref="debug_mode_security.module_category_debug_security"/>
        <field name="sequence">50</field>
    </record>

    <!-- Permission Group -->
    <record id="group_enable_debug" model="res.groups">
        <field name="name">Allow Debug Mode</field>
        <field name="privilege_id" ref="debug_mode_security.privilege_debug_security"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

</odoo>